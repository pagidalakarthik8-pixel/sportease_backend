# Copy this file to server/.env (same folder) and fill it in to turn on
# AUTOMATIC WhatsApp / SMS from the server (uses Twilio).
# Leave it out entirely and SportEase still works in click-to-send mode.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# WhatsApp sender. For testing use the Twilio WhatsApp Sandbox number.
TWILIO_WHATSAPP_FROM=+14155238886

# Optional: a normal Twilio SMS number, enables the SMS channel
# TWILIO_SMS_FROM=+1xxxxxxxxxx

# Optional: this WhatsApp number gets an alert whenever a student makes a booking
# ADMIN_PHONE=9876543210

# Country code added to 10-digit numbers (default 91 = India)
# DEFAULT_COUNTRY_CODE=91

# Shared secret for the ESP32 smart-locker reader (sent as the X-Device-Key header).
# Use any long random string and put the same value in the ESP32 firmware.
DEVICE_KEY=change-this-to-a-long-random-string
